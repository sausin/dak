<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: the release list (src/main/res/xml/locales_config.xml) plus the pseudo-locales generated by
    pseudoLocalesEnabled (app/build.gradle.kts), so testers can pick them in Settings → Appearance → Language:
    en-XA (accented, ~30% longer: truncation and hardcoded text) and ar-XB (mirrored right-to-left: layout).
    Keep the release entries in sync with the main file.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="en-XA" />
    <locale android:name="ar-XB" />
</locale-config>
