<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS/MMS permissions, and the SMS_DELIVER / WAP_PUSH_DELIVER / RESPOND_VIA_MESSAGE components, are declared
         by :core-telephony and merged in. They are only requested at runtime after Dak holds the SMS role. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Not requested: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is Play-restricted and a default SMS app is already woken
         for SMS_DELIVER / WAP_PUSH_DELIVER. Dak opens the battery-optimisation settings list instead (no permission
         needed). tools:node="remove" keeps a library from merging it back in. See docs/play-submission.md. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />

    <!-- Share location as a maps link from the composer. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Camera capture from the composer (the camera app does the capture; we only declare the feature optional). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Consumed-OTP detection: SMS Retriever hashes of launchable apps, and WebOTP-capable browsers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".DakApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dak"
        tools:targetApi="33">

        <!-- WorkManager is initialised on demand with Hilt's worker factory (DakApplication). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher shortcut "Report fraud" (app.dak.action.REPORT_FRAUD, see IntentRoutes). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Required for the default SMS role: compose to an address. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <!-- Share text or media into a new message. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Settings → Privacy: policy (offline), data-sharing consents, export and delete of Dak's own data.
             Not exported: only Dak's own screens open it. -->
        <activity
            android:name=".ui.privacy.PrivacyActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:label="@string/privacy_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification actions (copy code, delete, mark read, reply). Only our own PendingIntents reach it. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Scheduled sends: exact alarm target, rescheduled after reboot / clock changes. -->
        <receiver
            android:name=".automation.ScheduledSendReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- "Turn off" on the "Was this you?" security alert for auto-forwarding. Only our own PendingIntent reaches it. -->
        <receiver
            android:name=".automation.OutboundRuleReceiver"
            android:exported="false" />

        <!-- Camera capture target for the composer attachment tray. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dakfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dak_file_paths" />
        </provider>
    </application>
</manifest>
