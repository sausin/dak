    <!-- Incognito (vanishing) chats -->
    <string name="inc_label">Discussion privée</string>
    <string name="inc_action_on">Activer le mode privé</string>
    <string name="inc_action_off">Désactiver le mode privé</string>
    <string name="inc_turn_off">Désactiver</string>
    <string name="inc_dialog_title">Activer la discussion privée ?</string>
    <string name="inc_dialog_body">• Les messages que vous envoyez disparaissent de ce téléphone dès leur envoi.\n• Les messages que vous recevez sont masqués dans les notifications et disparaissent une fois lus ici.\n• Si un message ne peut pas être envoyé, vous choisissez : réessayer, supprimer ou le garder pour réessayer plus tard.\n• Les messages disparus ne passent pas par la corbeille et ne peuvent pas être restaurés.\n• Les messages précédents de cette discussion restent inchangés.</string>
    <string name="inc_intro_other_side_title">Seule votre copie disparaît</string>
    <string name="inc_intro_other_side_body">Dak ne peut supprimer des messages que sur ce téléphone. Le téléphone de votre correspondant conserve tout ce que vous lui envoyez, et les SMS ne permettent pas de le supprimer à distance. Il peut aussi avoir des captures d\'écran ou des sauvegardes.</string>
    <string name="inc_dialog_confirm">J\'ai compris, activer</string>
    <string name="inc_banner_title">Discussion privée</string>
    <string name="inc_banner_body">Les messages disparaissent de ce téléphone une fois envoyés ou lus. Votre correspondant conserve sa copie.</string>
