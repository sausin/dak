    <string name="settings_reset_body">इस सेक्शन की हर सेटिंग अपने डिफ़ॉल्ट पर लौट जाएगी। आपके मैसेज पर कोई असर नहीं पड़ेगा।</string>
    <string name="settings_action_unavailable">इस वर्शन में अभी उपलब्ध नहीं है</string>
    <string name="upgrade_title">Dak Premium</string>
    <string name="upgrade_body">Premium में सर्वर वाली और एडवांस यूज़र के लिए सुविधाएं जुड़ती हैं। मुफ़्त ऐप पूरी तरह डिवाइस पर ही चलता है।</string>
    <string name="upgrade_unavailable">Premium अभी बिक्री के लिए उपलब्ध नहीं है। अपग्रेड करते ही यहां दिखाई गई हर चीज़ बिना रीस्टार्ट के चालू हो जाएगी।</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Dak में आपका स्वागत है</string>
    <string name="onboarding_welcome_body">ज़रूरी मैसेज, व्यवस्थित: OTP, बैंक अलर्ट और टिकट, छांटे हुए और खोजने लायक।</string>
    <string name="onboarding_limits_title">SMS क्या नहीं कर सकता</string>
    <string name="onboarding_limit_typing">टाइपिंग इंडिकेटर नहीं</string>
    <string name="onboarding_limit_receipts">पढ़ने की रसीद नहीं</string>
    <string name="onboarding_limit_reactions">रिएक्शन नहीं भेजे जा सकते (iPhone से आए रिएक्शन टेक्स्ट के रूप में आते हैं; Dak उन्हें साफ़-सुथरा दिखाता है)</string>
    <string name="onboarding_limit_media">फ़ोटो और वीडियो आपके ऑपरेटर की MMS सीमा तक छोटे किए जाते हैं</string>
    <string name="onboarding_limit_delivery">जहां आपका ऑपरेटर सपोर्ट करता है, वहां पढ़ने की रसीद की जगह डिलीवरी रिपोर्ट मिलती है।</string>
    <string name="onboarding_rcs_title">RCS चैट बंद हो जाएगी</string>
    <string name="onboarding_rcs_body">RCS (Google Messages की चैट सुविधाएं) सिर्फ़ Google के ऐप में काम करता है। बदलने के बाद वे बातचीत SMS और MMS के रूप में जारी रहेंगी। आप कभी भी वापस बदल सकते हैं।</string>
    <string name="onboarding_private_title">आपके फ़ोन पर ही रहता है</string>
    <string name="onboarding_private_body">Dak आपके मैसेज कभी अपलोड नहीं करता। जो कुछ भी डिवाइस से बाहर जा सकता है, वह तब तक बंद रहता है जब तक आप उसे चालू न करें।</string>
    <string name="onboarding_role_title">Dak को अपना SMS ऐप बनाएं</string>
    <string name="onboarding_role_body">Android सिर्फ़ डिफ़ॉल्ट SMS ऐप को मैसेज पाने, भेजने और व्यवस्थित करने देता है। आपके मौजूदा मैसेज जहां हैं, वहीं रहेंगे।</string>
    <string name="onboarding_role_button">डिफ़ॉल्ट बनाएं</string>
    <string name="onboarding_role_point_receive">नए मैसेज Dak में आएंगे</string>
    <string name="onboarding_role_point_receive_body">OTP, बैंक अलर्ट और चैट की सूचनाएं आपके मौजूदा ऐप की जगह यहां आएंगी।</string>
    <string name="onboarding_role_point_switch">आप बंधे नहीं हैं</string>
    <string name="onboarding_role_point_switch_body">मैसेज सिस्टम स्टोर में रहते हैं, इसलिए वापस बदलने पर कोई भी SMS ऐप उन्हें पढ़ सकता है।</string>
    <string name="onboarding_role_declined">डिफ़ॉल्ट SMS ऐप बने बिना Dak काम नहीं कर सकता। जारी रखने के लिए अगले डायलॉग में Dak चुनें।</string>
    <string name="onboarding_permissions_title">कुछ और अनुमतियां</string>
    <string name="onboarding_permissions_body">हर अनुमति वैकल्पिक है, लेकिन तीनों के साथ Dak सबसे अच्छा काम करता है।</string>
    <string name="onboarding_permissions_button">अनुमति दें</string>
    <string name="onboarding_perm_notifications">सूचनाएं</string>
    <string name="onboarding_perm_notifications_body">ताकि OTP और अलर्ट आते ही आप तक पहुंचें।</string>
    <string name="onboarding_perm_contacts">संपर्क</string>
    <string name="onboarding_perm_contacts_body">नंबर की जगह नाम दिखाता है और लोगों और कारोबारों में फ़र्क करने में मदद करता है।</string>
    <string name="onboarding_perm_phone">फ़ोन और SIM</string>
    <string name="onboarding_perm_phone_body">आपके SIM को अलग-अलग पहचानता है, आपका अपना नंबर जानता है, और कॉल के दौरान OTP आने पर चेतावनी देता है।</string>
    <string name="onboarding_index_title">पुराने मैसेज व्यवस्थित करें</string>
    <string name="onboarding_index_body">आपके हाल के मैसेज अभी तैयार हैं। पुराने मैसेज की छंटाई और खोज आपकी सुविधा के समय हो सकती है।</string>
    <string name="onboarding_index_now">अभी</string>
    <string name="onboarding_index_now_body">सबसे तेज़। बड़े इनबॉक्स पर कुछ मिनट तक थोड़ी बैटरी लगती है।</string>
    <string name="onboarding_index_plugged">चार्जिंग पर लगने पर</string>
    <string name="onboarding_index_plugged_body">अगली बार चार्ज करते समय। बैटरी खर्च नहीं होती।</string>
    <string name="onboarding_index_tonight">आज रात</string>
