    <!-- Self-test -->
    <string name="selftest_title">सूचना सेल्फ़-टेस्ट</string>
    <string name="selftest_restricted_body">नीचे दी गई चीज़ें ठीक करें, ताकि OTP और बैंक अलर्ट आप तक हमेशा पहुंचें।</string>
    <string name="selftest_checks">जांच</string>
    <string name="selftest_local_section">टेस्ट सूचना</string>
    <string name="selftest_local_explain">आवाज़ और पॉप-अप जांचने के लिए अभी एक सूचना दिखाता है।</string>
