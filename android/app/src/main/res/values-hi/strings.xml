    <string name="selftest_local_title">Dak टेस्ट सूचना</string>
    <string name="selftest_local_body">अगर आपको यह दिख रहा है, तो Dak सूचनाएं दिखा सकता है।</string>
    <string name="selftest_local_posted">भेज दी गई। जांचें कि यह आवाज़ के साथ दिखी या नहीं।</string>
    <string name="selftest_local_blocked">ब्लॉक है: Dak की सूचनाएं बंद हैं।</string>
    <string name="selftest_sms_section">खुद को टेस्ट SMS भेजें</string>
    <string name="selftest_sms_explain">आपके अपने नंबर पर एक SMS भेजता है और मापता है कि उसे आने और सूचना दिखाने में कितना समय लगता है। आपका ऑपरेटर सामान्य SMS शुल्क ले सकता है।</string>
    <string name="selftest_own_number">आपका नंबर</string>
    <string name="selftest_sms_button">टेस्ट SMS भेजें</string>
    <!-- Body of the test SMS sent to the own number of the user. %1$s = a random code Dak looks for to recognise it: keep it. -->
    <string name="selftest_sms_body">Dak सेल्फ़-टेस्ट %1$s. अगर यह सूचना के रूप में दिख रहा है, तो डिलीवरी ठीक है।</string>
    <string name="selftest_sms_sending">भेजा जा रहा है…</string>
    <string name="selftest_sms_waiting">भेज दिया। आने का इंतज़ार है…</string>
    <!-- %1$d = seconds the test SMS took to arrive (unit: "s"). -->
    <string name="selftest_sms_received">%1$d सेकंड में मिला और सूचना दिखी। डिलीवरी ठीक है।</string>
    <!-- %1$d = seconds the test SMS took to arrive (unit: "s"). -->
    <string name="selftest_sms_received_no_notification">%1$d सेकंड में मिला, लेकिन सूचना ब्लॉक थी।</string>
    <!-- %1$s = why sending failed, from the phone or carrier (core-telephony strings_failures.xml). -->
    <string name="selftest_sms_failed">भेजा नहीं जा सका: %1$s</string>
    <string name="selftest_sms_timeout">2 मिनट में कुछ नहीं आया। नंबर जांचें, या दूसरा SIM आज़माएं।</string>
    <string name="selftest_sms_carrier_note">कुछ ऑपरेटर खुद को भेजे गए मैसेज देर से पहुंचाते हैं या छोड़ देते हैं; यहां टाइमआउट का मतलब हमेशा Dak में समस्या नहीं होता।</string>

