    <!-- Incognito (vanishing) chats -->
    <string name="inc_label">इनकॉग्निटो चैट</string>
    <string name="inc_action_on">इनकॉग्निटो चालू करें</string>
    <string name="inc_action_off">इनकॉग्निटो बंद करें</string>
    <string name="inc_turn_off">बंद करें</string>
    <string name="inc_dialog_title">इनकॉग्निटो चैट चालू करें?</string>
    <string name="inc_dialog_body">• आपके भेजे मैसेज भेजते ही इस फ़ोन से गायब हो जाते हैं।\n• आपको मिलने वाले मैसेज सूचनाओं में छिपे रहते हैं और यहां पढ़ने के बाद गायब हो जाते हैं।\n• अगर कोई मैसेज नहीं भेजा जा सका, तो आप चुनते हैं: फिर से कोशिश करें, मिटाएं, या बाद में कोशिश के लिए रखें।\n• गायब हुए मैसेज रीसायकल बिन में नहीं जाते और वापस नहीं लाए जा सकते।\n• इस चैट के पहले के मैसेज जैसे हैं वैसे ही रहते हैं।</string>
    <string name="inc_intro_other_side_title">सिर्फ़ आपकी कॉपी गायब होती है</string>
    <string name="inc_intro_other_side_body">Dak सिर्फ़ इसी फ़ोन पर मैसेज मिटा सकता है। दूसरे व्यक्ति के फ़ोन पर आपके भेजे सभी मैसेज रहते हैं, और SMS में उन्हें वहां से मिटाने का कोई तरीका नहीं है। उनके पास स्क्रीनशॉट या बैकअप भी हो सकते हैं।</string>
    <string name="inc_dialog_confirm">मैं समझ गया/गई, चालू करें</string>
    <string name="inc_banner_title">इनकॉग्निटो चैट</string>
    <string name="inc_banner_body">मैसेज भेजने या पढ़ने के बाद इस फ़ोन से गायब हो जाते हैं। दूसरे व्यक्ति के पास उनकी कॉपी रहती है।</string>
    <string name="inc_inbox_snippet">इनकॉग्निटो चैट · पढ़ने के लिए खोलें</string>
    <string name="inc_notification_body">नया इनकॉग्निटो मैसेज · पढ़ने के लिए Dak खोलें</string>
    <string name="inc_vanishing">मैसेज गायब हो रहा है</string>
    <string name="inc_countdown">यह मैसेज कुछ सेकंड में गायब हो जाएगा</string>
    <string name="inc_snack_on">इनकॉग्निटो चालू · सिर्फ़ आपकी कॉपी गायब होगी</string>
    <string name="inc_failed_first">नहीं भेजा गया। फिर से कोशिश करें, या मिटा दें?</string>
    <string name="inc_failed_again">अब भी नहीं भेजा गया। बाद में कोशिश के लिए रखें, या मिटा दें?</string>
