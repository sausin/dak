<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: themed background (day/night via the colour resource) and the launcher mark. -->
    <style name="Theme.Dak" parent="Base.Theme.Dak">
        <item name="android:windowSplashScreenBackground">@color/dak_window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
