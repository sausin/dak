    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Dak</string>
    <string name="onboarding_welcome_body">The messages that matter, organised: OTPs, bank alerts and tickets, sorted and searchable.</string>
    <string name="onboarding_limits_title">What SMS can\'t do</string>
    <string name="onboarding_limit_typing">No typing indicators</string>
    <string name="onboarding_limit_receipts">No read receipts</string>
    <string name="onboarding_limit_reactions">No sending reactions (reactions from iPhones arrive as text; Dak tidies them)</string>
    <string name="onboarding_limit_media">Photos and videos are compressed to your carrier\'s MMS limit</string>
    <string name="onboarding_limit_delivery">Delivery reports stand in for read receipts where your carrier supports them.</string>
    <string name="onboarding_rcs_title">You will lose RCS chat</string>
    <string name="onboarding_rcs_body">RCS (chat features in Google Messages) works only in Google\'s app. After switching, those conversations continue as SMS and MMS. You can switch back at any time.</string>
    <string name="onboarding_private_title">Stays on your phone</string>
    <string name="onboarding_private_body">Dak never uploads your messages. Anything that would leave the device is off until you turn it on.</string>
    <string name="onboarding_role_title">Make Dak your SMS app</string>
    <string name="onboarding_role_body">Android lets only the default SMS app receive, send and organise messages. Your existing messages stay exactly where they are.</string>
    <string name="onboarding_role_button">Set as default</string>
    <string name="onboarding_role_point_receive">New messages arrive in Dak</string>
    <string name="onboarding_role_point_receive_body">OTPs, bank alerts and chats notify here instead of your current app.</string>
    <string name="onboarding_role_point_switch">Nothing is locked in</string>
    <string name="onboarding_role_point_switch_body">Messages stay in the system store, so any SMS app can read them if you switch back.</string>
    <string name="onboarding_role_declined">Dak can\'t work without being the default SMS app. Choose Dak in the next dialog to continue.</string>
    <string name="onboarding_permissions_title">A few more permissions</string>
    <string name="onboarding_permissions_body">Each one is optional, but Dak works best with all three.</string>
    <string name="onboarding_permissions_button">Allow</string>
    <string name="onboarding_perm_notifications">Notifications</string>
    <string name="onboarding_perm_notifications_body">So OTPs and alerts reach you the moment they arrive.</string>
    <string name="onboarding_perm_contacts">Contacts</string>
    <string name="onboarding_perm_contacts_body">Shows names instead of numbers and helps tell people from businesses.</string>
    <string name="onboarding_perm_phone">Phone and SIM</string>
    <string name="onboarding_perm_phone_body">Tells your SIMs apart, knows your own number, and warns when an OTP arrives during a call.</string>
    <string name="onboarding_index_title">Organise your old messages</string>
    <string name="onboarding_index_body">Your latest messages are ready now. Sorting and search for older ones can run when it suits you.</string>
    <string name="onboarding_index_now">Now</string>
    <string name="onboarding_index_now_body">Fastest. Uses some battery for a few minutes on a large inbox.</string>
    <string name="onboarding_index_plugged">When plugged in</string>
    <string name="onboarding_index_plugged_body">Next time you charge. No battery cost.</string>
    <string name="onboarding_index_tonight">Tonight</string>
    <string name="onboarding_index_tonight_body">Overnight while you are not using the phone.</string>
    <string name="onboarding_reliability_title">Never miss an OTP</string>
    <string name="onboarding_reliability_body">Some phones pause apps in the background to save battery, which delays messages. Two quick settings prevent that.</string>
    <string name="onboarding_battery_title">Battery optimisation</string>
    <string name="onboarding_battery_body">Let Dak run in the background so new messages always notify. Your phone\'s battery settings will open: find Dak there and turn off battery optimisation.</string>
    <string name="onboarding_battery_done">Done: Dak is allowed to run in the background.</string>
    <string name="onboarding_battery_button">Open battery settings</string>
    <!-- %1$s = phone brand as printed on the phone, e.g. "Xiaomi" (not translated). -->
    <string name="onboarding_oem_title">Extra step on %1$s phones</string>
    <string name="onboarding_oem_button">Open settings</string>
    <string name="onboarding_selftest_hint">You can check everything later in Settings → Notifications → Notification self-test.</string>
