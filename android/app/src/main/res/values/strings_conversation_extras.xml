<!--
  Conversation extras: contact details from the thread header (prefix cd_), send-later from the composer (sch_),
  incognito / vanishing chats (inc_), accounts removed from the Passbook (pb_), other dates for wishes (occ_).
-->
<resources>
    <!-- Contact details sheet (tap the thread header) -->
    <string name="cd_open_details">View contact details</string>
    <string name="cd_not_saved">Not in your contacts</string>
    <!-- %1$s = the contact's name -->
    <string name="cd_saved_as">Saved as %1$s</string>
    <string name="cd_business_sender">Business sender · can\'t be called or saved</string>
    <string name="cd_no_contacts_permission">Dak can\'t read your contacts, so saved names aren\'t shown. Allow contacts access in Settings to see them.</string>
    <string name="cd_call">Call</string>
    <string name="cd_copy_number">Copy number</string>
    <string name="cd_number_copied">Number copied</string>
    <string name="cd_view_contact">View contact</string>
    <string name="cd_save_contact">Save as new contact</string>
    <string name="cd_add_to_existing">Add to existing</string>

    <!-- Send later -->
    <string name="sch_send_later">Send later</string>
    <string name="sch_tray_schedule">Schedule</string>
    <string name="sch_pick_date_time">Pick date &amp; time…</string>
    <string name="sch_write_first">Write your message first, then choose when it goes</string>
    <string name="sch_pick_future">Pick a time at least a minute from now</string>
