    <!-- Incognito (vanishing) chats -->
    <string name="inc_label">Incognito chat</string>
    <string name="inc_action_on">Turn on incognito</string>
    <string name="inc_action_off">Turn off incognito</string>
    <string name="inc_turn_off">Turn off</string>
    <string name="inc_dialog_title">Turn on incognito chat?</string>
    <string name="inc_dialog_body">• Messages you send vanish from this phone as soon as they\'re sent.\n• Messages you receive are hidden in notifications and vanish after you read them here.\n• If a message can\'t be sent, you choose: retry, delete, or keep it to try later.\n• Vanished messages skip the recycle bin and can\'t be restored.\n• Earlier messages in this chat stay as they are.</string>
    <string name="inc_intro_other_side_title">Only your copy vanishes</string>
    <string name="inc_intro_other_side_body">Dak can delete messages on this phone only. The other person\'s phone keeps everything you send them, and SMS has no way to delete it there. They may also have screenshots or backups.</string>
    <string name="inc_dialog_confirm">I understand, turn on</string>
    <string name="inc_banner_title">Incognito chat</string>
    <string name="inc_banner_body">Messages vanish from this phone once sent or read. The other person keeps their copy.</string>
    <string name="inc_inbox_snippet">Incognito chat · open to read</string>
    <string name="inc_notification_body">New incognito message · open Dak to read</string>
    <string name="inc_vanishing">Message vanishing</string>
    <string name="inc_countdown">This message vanishes in a few seconds</string>
    <string name="inc_snack_on">Incognito on · only your copy vanishes</string>
    <string name="inc_failed_first">Not sent. Try again, or delete it?</string>
    <string name="inc_failed_again">Still not sent. Keep it to try later, or delete it?</string>
    <!-- %1$d = seconds left before the message is deleted. -->
    <plurals name="inc_failed_deletes_in">
        <item quantity="one">Deleted in %1$d second if you don\'t choose</item>
        <item quantity="other">Deleted in %1$d seconds if you don\'t choose</item>
    </plurals>
    <string name="inc_failed_retry">Retry</string>
    <string name="inc_failed_keep">Keep</string>
    <string name="inc_failed_delete">Delete</string>

    <!-- Passbook: removing accounts that are not relevant -->
    <string name="pb_hide">Remove from Passbook</string>
    <string name="pb_unhide">Show in Passbook</string>
    <string name="pb_hidden_snack">Removed from Passbook</string>
