<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only (no AppCompat): Compose draws everything; this sets the pre-Compose window. -->
    <style name="Base.Theme.Dak" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dak_window_background</item>
        <item name="android:colorPrimary">@color/dak_brand</item>
        <item name="android:colorAccent">@color/dak_brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Dak" parent="Base.Theme.Dak" />
</resources>
